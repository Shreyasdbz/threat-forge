                },
                "tool": {
                  "const": "add_trust_boundary",
                  "type": "string"
                }
              },
              "required": [
                "tool",
                "arguments"
              ],
              "type": "object"
            },
            {
              "properties": {
                "arguments": {
                  "$ref": "#/$defs/DeleteByIdRequest"
                },
                "tool": {
                  "const": "delete_trust_boundary",
