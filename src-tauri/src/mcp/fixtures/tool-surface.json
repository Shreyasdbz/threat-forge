  {
    "name": "create_document",
    "description": "Create a new .thf in the configured workspace and make it active.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "author": {
          "default": "",
          "type": "string"
        },
        "path": {
          "description": "New workspace-relative .thf path; parent folder must exist",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "title"
      ],
      "type": "object"
    }
  },
  {
