    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "dx": {
          "format": "double",
          "type": "number"
        },
        "dy": {
          "format": "double",
          "type": "number"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "dx",
