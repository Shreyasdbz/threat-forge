          "description": "ID of the item to delete",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "export_png",
    "description": "Render the active diagram as PNG; optionally save it under the workspace root.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "diagram_id": {
          "description": "Optional diagram ID. Omit to render the graph.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Optional workspace-relative output path with the matching extension",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "export_svg",
    "description": "Render the active diagram as SVG; optionally save it under the workspace root.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "diagram_id": {
          "description": "Optional diagram ID. Omit to render the graph.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Optional workspace-relative output path with the matching extension",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "get_model",
    "description": "Get the full threat model as JSON. Returns metadata, elements, data flows, trust boundaries, and threats.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    }
  },
  {
    "name": "get_sequence_view",
    "description": "Read ordered lifelines and messages for a typed sequence view by diagram ID. Offset and limit page each list (limit defaults to 50, maximum 200).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "diagram_id": {
          "type": "string"
        },
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "diagram_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "list_documents",
    "description": "List up to 200 workspace-relative .thf paths.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    }
  },
  {
    "name": "list_elements",
    "description": "List all elements in the threat model with their IDs, types, and names.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    }
  },
  {
    "name": "list_threats",
